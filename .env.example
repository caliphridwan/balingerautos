# ─── Database (PostgreSQL) ────────────────────────────────────────────
# Local example. For Neon, use the pooled connection string for DATABASE_URL
# and the direct (non-pooled) string for DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balinger_autos?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/balinger_autos?schema=public"

# ─── Site ─────────────────────────────────────────────────────────────
# Public base URL: canonical URLs, sitemap, email links, WhatsApp vehicle links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Authentication (NextAuth) ────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── Seed: first SUPER_ADMIN account ──────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
SEED_ADMIN_NAME="Site Administrator"

# ─── Cloudinary (vehicle, content and trade-in images) ───────────────
# Dashboard → Settings → API Keys. Uploads are disabled until these are set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder prefix inside your Cloudinary account
CLOUDINARY_FOLDER="balinger"

# ─── Email (Resend) ───────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are skipped and logged to the console.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend
EMAIL_FROM="Balinger Autos <no-reply@yourdomain.com>"
# Where new-lead notifications go (falls back to the email in Site Settings)
ADMIN_NOTIFICATION_EMAIL=""

# ─── AI assistant (optional) ──────────────────────────────────────────
# The chat assistant is hidden unless a key is set.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
